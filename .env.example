# Copiez ce fichier vers env.local et remplissez vos vraies valeurs.
# Ne commitez JAMAIS env.local (déjà dans .gitignore).

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

PORT=8080
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_URL=http://localhost:19957
# Production (Render) — UNE seule URL, sans virgule :
# FRONTEND_URL=https://davilla-rondeur.fr
# Origines CORS supplémentaires (liste séparée par des virgules) :
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://portail.davilla-rondeur.fr

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook local : stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM="Davilla Rondeur <noreply@davilla-rondeur.fr>"
# Domaine vérifié dans Resend + enregistrements DNS (SPF/DKIM) sur Cloudflare

# Admin back-office
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi
ADMIN_JWT_SECRET=generez-une-chaine-aleatoire-longue

# Cloudflare R2 (stockage médias — S3)
# R2_ACCOUNT_ID = l'identifiant dans https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=davilla-rondeur
# R2_PUBLIC_URL = domaine custom (media.davilla-rondeur.fr) une fois lié au bucket dans Cloudflare R2
# R2_SERVE_VIA_API=true = URLs publiques via https://api.davilla-rondeur.fr/api/media/... (recommandé)
R2_PUBLIC_URL=https://media.davilla-rondeur.fr
R2_SERVE_VIA_API=true

# Cloudflare Workers (déploiement wrangler — boutique + portail)
# ≠ clés R2 ci-dessus. Token : Dashboard → API Tokens → Edit Cloudflare Workers
# Portail → worker davilla-rondeur-portail → portail.davilla-rondeur.fr
# Boutique → worker davilla-rondeur → davilla-rondeur.fr
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=482f6d7406a79ec809079a667674fbdc

# La Poste Colissimo — Web Service d'affranchissement (contrat pro La Poste)
# Identifiants : espace https://www.colissimo.entreprise.laposte.fr/
COLISSIMO_CONTRACT_NUMBER=
COLISSIMO_PASSWORD=
# Optionnel :
# COLISSIMO_API_URL=https://ws.colissimo.fr/sls-ws/SlsServiceWSRest/2.0/generateLabel
# COLISSIMO_PRODUCT_CODE_FR=DOM
# COLISSIMO_PRODUCT_CODE_INTL=COLI
# COLISSIMO_DEFAULT_WEIGHT_GRAMS=500
# COLISSIMO_COMMERCIAL_NAME=Davilla Rondeur
# SHIP_FROM_NAME=Davilla Rondeur
# SHIP_FROM_LINE1=27 place des fleurs
# SHIP_FROM_POSTAL_CODE=78955
# SHIP_FROM_CITY=Carrières-sous-Poissy
# SHIP_FROM_COUNTRY=FR
# SHIP_FROM_PHONE=+33603686294
# SHIP_FROM_EMAIL=support@davilla-rondeur.fr
