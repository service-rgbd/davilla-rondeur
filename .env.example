# Copiez ce fichier vers env.local et remplissez vos vraies valeurs.
# Ne commitez JAMAIS env.local (déjà dans .gitignore).

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

PORT=8080
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_URL=http://localhost:19957
# Production (Render) : https://davilla-rondeur.fr
# URL publique de l'API : https://api.davilla-rondeur.fr
# APP_URL n'est pas lue par le code. Sur Render, gardez FRONTEND_URL = site prod.
# Origines CORS supplémentaires (Render) — séparées par des virgules :
# ALLOWED_ORIGINS=http://localhost:19957,http://127.0.0.1:19957

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook local : stripe listen --forward-to localhost:8080/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM="Davilla Rondeur <noreply@davilla-rondeur.fr>"
# Domaine vérifié dans Resend + enregistrements DNS (SPF/DKIM) sur Cloudflare

# Admin back-office
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi
ADMIN_JWT_SECRET=generez-une-chaine-aleatoire-longue

# Cloudflare R2
# R2_ACCOUNT_ID = l'identifiant dans https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=davilla-rondeur
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
